<Window x:Class="PUBGMortar.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt PUBGMortar" Height="230" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E2E">
    <StackPanel Margin="20">
        <TextBlock Text="Nhập key sử dụng" FontSize="18" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Liên hệ người quản lý để lấy key." Foreground="#AAAAAA" Margin="0,4,0,16"/>
        <TextBox x:Name="KeyInput" Padding="6" FontSize="14" KeyDown="KeyInput_KeyDown"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Thoát" Width="80" Margin="0,0,8,0" Click="ExitButton_Click"/>
            <Button Content="Kích hoạt" Width="80" Click="ActivateButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
